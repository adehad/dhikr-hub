{
  "name": "dhikr-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p worker && tsc -p site/assets/live",
    "pretest": "node -e \"const fs = require('fs'); const f = 'site/public/live/index.html'; fs.mkdirSync('site/public/live', {recursive: true}); if (!fs.existsSync(f)) fs.writeFileSync(f, '<!doctype html><html><head><title>Live | Dhikr Hub</title><meta name=description content=Live></head><body><div id=live-app></div></body></html>')\"",
    "test": "vitest run && vitest run --config vitest.client.config.ts",
    "dev:worker": "wrangler dev"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@cloudflare/workers-types": "^5.20261007.1",
    "happy-dom": "^18.0.0",
    "typescript": "^5.7.0",
    "vitest": "~4.1.11",
    "wrangler": "^4.148.0"
  }
}
