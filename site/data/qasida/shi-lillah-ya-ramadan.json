{
    "name": {
        "ara": "شِيئ لِلَّهِ يَا رَمَضَان",
        "en": "Shī' li-llāh yā Ramaḍān - Grant us for Allah's sake, O Ramadan"
    },
    "verses": {
        "ara": [
            "شِيئ لِلَّهِ يَا رَمَضَان",
            "شِيئ لِلَّهِ يَا رَمَضَان",
            "شِيئ لِلَّهِ يَا رَمَضَان",
            "بِالْقَبُولِ وَالْغُفْرَانِ",

            "يَا حَنَّانُ يَا مَنَّانُ",
            "يَا قَدِيمَ الْإِحْسَانِ",
            "بَحْرُ جُودِكَ مَلْيَانُ",
            "جُدْ لَنَا بِالْغُفْرَانِ",

            "رَبَّنَا نَسْتَعْفِيكَ",
            "رَبَّنَا نَسْتَرْضِيكَ",
            "وَلَنَا ظَنٌّ فِيك",
            "يَا رَجَاءَ أَهْلِ الْإِيمَانِ",

            "لَا تُخَيِّبُ رَاجِي",
            "تَحْتَ بَابِكَ لَاجِي",
            "لَمْ يَزَلْ فِي الدَّاجِي",
            "قَائِلاً يَا حَنَّان",

            "بِالنَّبِيِّ الْأُمِّيِّ",
            "وَخَدِيجَةَ أُمِّي",
            "وَالْبَتُولِ الْخَتْمِى",
            "سَيِّدَاتِ النِّسْوَانِ",

            "والصَّلَاةُ الدَّائِم",
            "عَلَى النَّبِيِّ بْنِ هَاشِمْ",
            "عَدَّ مَنْ هُوَ قَائِم",
            "بِالْعِبَادَةْ سَهْرَان"
        ],
        "en": [
            "Shī' li-llāh yā Ramaḍān",
            "Shī' li-llāh yā Ramaḍān",
            "Shī' li-llāh yā Ramaḍān",
            "bi-l-qabūli wa-l-ghufrāni",

            "yā Ḥannān yā Mannān",
            "yā Qadīma l-Iḥsāni",
            "baḥru jūdika malyān",
            "jud lanā bi-l-ghufrāni",

            "rabbanā nastaʿfīka",
            "rabbanā nastarḍīka",
            "wa-lanā ẓannun fīka",
            "yā rajā'a ahli l-īmāni",

            "lā tukhayyibu rājī",
            "taḥta bābika lā jī",
            "lam yazal fī d-dājī",
            "qā'ilan yā Ḥannān",

            "bi-n-nabiyyi l-ummī",
            "wa-Khadīja ummī",
            "wa-l-Batūli l-Khatmi",
            "sayyidāti n-niswān",

            "wa-ṣ-ṣalātu d-dā'im",
            "ʿalā n-nabiyyi bni Hāshim",
            "ʿadda man huwa qā'im",
            "bi-l-ʿibādati sahrān"
        ]
    },
    "translation": {
        "en": [
            "O Ramadan, for the sake of Allah,",
            "O Ramadan, for the sake of Allah,",
            "O Ramadan, for the sake of Allah,",
            "with acceptance and forgiveness.",

            "O Tenderly Compassionate, O Ever‑Bestowing,",
            "O Eternal Giver of kindness,",
            "Your sea of generosity is overflowing",
            "grant us Your forgiveness.",

            "Our Lord, we seek Your pardon,",
            "Our Lord, we seek to please You.",
            "We hold hope in You,",
            "refuge for the faithful hearts.",

            "Do not turn away the one pleads",
            "waiting at Your door in need,",
            "Who in the darkness has never ceased",
            "calling, “O Compassionate One.”",

            "By the unlettered Prophet",
            "and Khadijah, Mother of Believers,",
            "And the chaste Fatimah,",
            "leader of virtuous women.",

            "And everlasting blessings",
            "upon the Prophet, son of Hashim,",
            "As many as those who stand",
            "in worship through the sleepless night."
        ]
    },
